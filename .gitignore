# Binaries
bin/
/panecom
*.exe

# Runtime state
.panecom/sessions/
# exec was removed in v3.0.0 and is no longer created, but data left by
# earlier versions stays on disk and can contain command output.
.panecom/exec/
.panecom/exec.lock
# Links hold machine-specific absolute paths; declare shared ones in
# .panecom.yaml under profiles.<name>.external_projects instead.
.panecom/externals/

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# tracecraft sessions
.tracecraft/
